# --- Startup-validated (server refuses to boot if missing/invalid) ---
OPENAI_API_KEY=sk-...

# --- Lazily validated (checked when the owning service is first used) ---
ELEVENLABS_API_KEY=...
# Seconds a fetched finetunes page stays cached; 0 disables caching
FINETUNES_CACHE_TTL=300

# --- General application settings ---
APP_NAME=keepsong-mcp
APP_VERSION=0.1.0
# development | production
ENVIRONMENT=development

# --- Storage ---
# local | azure
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=output/music
# Azure (required at startup when STORAGE_BACKEND=azure; connection string takes
# precedence over account URL + managed identity)
#AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
#AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=music

# --- Database ---
# Dev default: local SQLite file. Production: postgres://... (always TLS).
DATABASE_URL=./data/renders.db
#DATABASE_URL=postgres://user:pass@host:5432/keepsong

# --- MCP transport ---
# http | stdio  (stdio is for local dev; --stdio CLI flag also works)
MCP_TRANSPORT=http
MCP_PORT=3000
MCP_PATH=/mcp

# --- Entra ID auth (required when AUTH_ENABLED=true) ---
# Defaults: true when ENVIRONMENT=production, false otherwise. Never applies to stdio.
#AUTH_ENABLED=true
#ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Expected `aud` claim: the App Registration's Application ID URI or client ID
#ENTRA_AUDIENCE=api://keepsong-mcp
