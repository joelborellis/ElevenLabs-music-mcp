# --- Startup-validated (server refuses to boot if missing/invalid) ---
OPENAI_API_KEY=

# --- Lazily validated (checked when the owning service is first used) ---
ELEVENLABS_API_KEY=
# Seconds a fetched finetunes page stays cached; 0 disables caching (default: 300)
FINETUNES_CACHE_TTL=

# --- General application settings ---
# Default: keepsong-mcp
APP_NAME=
# Default: 0.1.0
APP_VERSION=
# development | production (default: development)
ENVIRONMENT=

# --- Storage ---
# local | azure (default: local)
STORAGE_BACKEND=
# Local FS base dir, used only when STORAGE_BACKEND=local (default: output/music)
LOCAL_STORAGE_DIR=
# Azure (required at startup when STORAGE_BACKEND=azure; connection string takes
# precedence over account URL + managed identity)
# e.g. https://<account>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=
# Dev-only fallback if you don't use `az login`/managed identity locally
AZURE_STORAGE_CONNECTION_STRING=
# Default: music
AZURE_STORAGE_CONTAINER=

# --- Database ---
# Dev default: local SQLite file (./data/renders.db). Production: postgres://... (always TLS).
DATABASE_URL=

# --- MCP transport ---
# http | stdio (default: http; --stdio CLI flag also works)
MCP_TRANSPORT=
# Default: 3000
MCP_PORT=
# Default: /mcp
MCP_PATH=

# --- Entra ID auth (ENTRA_* required when AUTH_ENABLED=true) ---
# Setup for Microsoft 365 Copilot (Entra SSO): see docs/copilot-auth.md
# Defaults: true when ENVIRONMENT=production, false otherwise. Never applies to stdio.
AUTH_ENABLED=
ENTRA_TENANT_ID=
# Accepted `aud` claims, comma-separated. For Copilot, list the client ID, api://<client-id>,
# and the Application ID URI the Teams developer portal generated for the SSO auth config, e.g.
# <client-id>,api://<client-id>,api://auth-<uuid>/<client-id>
ENTRA_AUDIENCE=
# Delegated scope every token must carry (default: access_as_user). Set to "none" to disable.
ENTRA_REQUIRED_SCOPE=

# --- Copilot UI / media ---
# This server's public origin as Copilot and the studio card see it (dev tunnel or Azure URL).
# Used for signed audio links and the widget's CSP. Default: http://localhost:<MCP_PORT>
PUBLIC_BASE_URL=
# HMAC key for short-lived signed audio URLs (any long random string, e.g. `openssl rand -hex 32`).
# Required in production; in development an unset key means links die on restart.
MEDIA_SIGNING_KEY=

# --- CORS ---
# Exact origins allowed to call /mcp from a browser, comma-separated. For Copilot MCP Apps add the
# widget host from https://aka.ms/mcpwidgeturlgenerator
# (https://<hash>.widget-renderer.usercontent.microsoft.com). Default: none.
CORS_ALLOWED_ORIGINS=
